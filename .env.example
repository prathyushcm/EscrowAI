# ==============================================================================
# EscrowAI Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env`:
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows cmd)
#      Copy-Item .env.example .env (Windows PowerShell)
# 2. Fill in your actual credentials below.
# 3. NEVER commit your real `.env` file to version control.
# ==============================================================================

# Google Gemini API Key (Required for multi-agent Evaluator & Critic evaluation)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Model designation (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Razorpay Test / Live API Keys (Required for escrow payment link generation)
# Obtain keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
